//to print diagnols of a matrix
import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner obj = new Scanner(System.in);

        int n = obj.nextInt();
        int arr[][] = new int[n][n];

        int i, j;

        System.out.println("Enter array elements:");
        for (i = 0; i < n; i++) {
            for (j = 0; j < n; j++) {
                arr[i][j] = obj.nextInt();
            }
        }

        System.out.print("First Diagonal elements: ");
        for (i = 0; i < n; i++) {
            System.out.print(arr[i][i] + " ");
        }

        System.out.println();

        System.out.print("Second Diagonal elements: ");
        for (i = 0; i < n; i++) {
            System.out.print(arr[i][n - 1 - i] + " ");
        }
    }
}


// transpose a matrix
import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner obj = new Scanner(System.in);

        int n = obj.nextInt();
        int arr[][] = new int[n][n];

        for (int i = 0; i < n; i++) {
            for (int j = 0; j < n; j++) {
                arr[i][j] = obj.nextInt();
            }
        }

        // Transpose
        for (int i = 0; i < n; i++) {
            for (int j = i + 1; j < n; j++) {
                int temp = arr[i][j];
                arr[i][j] = arr[j][i];
                arr[j][i] = temp;
            }
        }

        // Print
        for (int i = 0; i < n; i++) {
            for (int j = 0; j < n; j++) {
                System.out.print(arr[i][j] + " ");
            }
            System.out.println();
        }
    }
}
