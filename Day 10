//to print no of words
import java.util.*;

class Main {
    public static void main(String[] args) {
        Scanner obj = new Scanner(System.in);

        String s = obj.nextLine();
        int c = 0;

        for (char ch : s.toCharArray()) {
            if (ch == ' ') {
                c++;
            }
        }

        System.out.print("Total Number of words: " + (c + 1));
    }
}
