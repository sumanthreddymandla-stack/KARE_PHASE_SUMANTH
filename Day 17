//sum of the elements in circular singly linked list

class Main {
    static class Node {
        int data;
        Node next;

        Node(int data) {
            this.data = data;
        }
    }

    public static void main(String[] args) {
        Node head = new Node(10);
        Node n2 = new Node(20);
        Node n3 = new Node(30);
        Node n4 = new Node(40);

        head.next = n2;
        n2.next = n3;
        n3.next = n4;
        n4.next = head;   

        int sum = 0;
        Node temp = head;

        do {
            sum += temp.data;
            temp = temp.next;
        } while (temp != head);

        System.out.println("Sum = " + sum);
    }
}


