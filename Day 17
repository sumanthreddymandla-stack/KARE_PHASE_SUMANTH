//sort elements in circular singly linked list 

class Main {
    static class Node {
        int data;
        Node next;

        Node(int data) {
            this.data = data;
        }
    }

    public static void main(String[] args) {
        Node head = new Node(30);
        Node n2 = new Node(10);
        Node n3 = new Node(40);
        Node n4 = new Node(20);

        head.next = n2;
        n2.next = n3;
        n3.next = n4;
        n4.next = head;

        Node i = head;

        do {
            Node j = i.next;

            while (j != head) {
                if (i.data > j.data) {
                    int temp = i.data;
                    i.data = j.data;
                    j.data = temp;
                }
                j = j.next;
            }

            i = i.next;
        } while (i != head);

        Node temp = head;

        do {
            System.out.print(temp.data + " ");
            temp = temp.next;
        } while (temp != head);
    }
}

