//strong number
import java.util.*;

class Main {
    public static void main(String[] args) {
        Scanner obj = new Scanner(System.in);
        int n = obj.nextInt();
        int temp = n;
        int sum = 0;
        while (n != 0) {
            int d = n % 10;
            int fact = 1;
            for (int i = 1; i <= d; i++) {
            fact = fact * i;
            }

            sum = sum + fact;
            n = n / 10;
        }

        if (temp == sum)
            System.out.println("Strong Number");
        else
            System.out.println("Not A Strong Number");
    }
}


//Armstrong number
import java.util.*;

class Main {
    public static void main(String[] args) {
        Scanner obj = new Scanner(System.in);
        int n = obj.nextInt();
        int temp = n,c=0,d,sum=0;
        while (n != 0) 
        {
            n=n/10;
            c++;
        }

        n=temp;
        while(n!=0)
        {
            d=n%10;
            sum=sum+(int)Math.pow(d,c);
            n=n/10;
        }

        if (temp == sum)
            System.out.println("Armstrong Number");
        else
            System.out.println("Not A Armstrong Number");
    }
}


//Adam number
import java.util.*;

class Main {
    public static void main(String[] args) {
        Scanner obj = new Scanner(System.in);
        int n = obj.nextInt();
        int sn = n*n;
        int rn=0,d,ans=0;
        while (n != 0) 
        {
            d=n%10;
            rn=rn*10+d;
            n=n/10;
        }

        int srn = rn*rn;
        while(srn!=0)
        {
            d=srn%10;
            ans=ans*10+d;
            srn=srn/10;
        }

        if (ans == sn)
            System.out.println("Adam Number");
        else
            System.out.println("Not A Adam Number");
    }
}


